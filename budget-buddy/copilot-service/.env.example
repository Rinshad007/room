# LLM Configuration
OPENAI_API_KEY="gsk_your_groq_api_key_here"
OPENAI_MODEL="openai/gpt-oss-120b"
OPENAI_BASE_URL="https://api.groq.com/openai/v1"

# Database (PostgreSQL for production, SQLite for local dev)
