# Copy this file to .env and fill in your Firebase project credentials
VITE_API_URL=https://your-render-backend.onrender.com/api/v1/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Public origin of the MCP service (HTTPS in production, no /mcp suffix).
# Prefer the same parent domain as the frontend for account-linking cookies.
VITE_MCP_SERVER_URL=https://mcp.your-domain.com
