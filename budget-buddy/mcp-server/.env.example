# Local configuration. Production needs HTTPS URLs and secure cookies.
PORT=3001
MCP_PUBLIC_URL=http://localhost:3001/mcp
OAUTH_ISSUER_URL=http://localhost:3001
BUDGETBUDDY_APP_URL=http://localhost:5173
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Absolute path to a server-only Firebase service-account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repo/service-account.json
# For hosts without secret files, base64-encode the complete service-account JSON instead.
# This takes precedence over GOOGLE_APPLICATION_CREDENTIALS.
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
OAUTH_CLIENT_ID=budgetbuddy-chatgpt
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OAUTH_CLIENT_SECRET=
# Copy EXACT callback(s) from your client's connection setup; comma separated.
# Example ONLY: Inspector commonly uses http://localhost:6274/oauth/callback
OAUTH_REDIRECT_URIS=http://localhost:6274/oauth/callback
OAUTH_SECURE_COOKIES=false
TRUST_PROXY_HOPS=0
# For local emulator use ONLY, set project ID to demo-budgetbuddy:
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
